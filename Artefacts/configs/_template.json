{
    "$comment": "This is a template file. Copy and rename it to create your own parser.",
    "$schema": "./parser-config.schema.json",
    
    "name": "MyFileFormat",
    "description": "Description of your file format",
    "version": "1.0",
    "author": "Your Name",
    
    "magic_bytes": "00000000",
    "magic_offset": 0,
    "endianness": "little",
    
    "references": [
        "https://link-to-format-documentation.com"
    ],
    
    "fields": [
        {
            "name": "signature",
            "size": 4,
            "type": "bytes",
            "description": "File signature/magic bytes",
            "forensic_value": true
        },
        {
            "name": "version",
            "size": 2,
            "type": "uint",
            "description": "Format version number",
            "informational": true
        },
        {
            "name": "flags",
            "size": 4,
            "type": "bitfield",
            "description": "Feature flags",
            "bit_flags": {
                "0": "Flag0 Description",
                "1": "Flag1 Description",
                "2": "Flag2 Description"
            }
        },
        {
            "name": "timestamp",
            "size": 8,
            "type": "filetime",
            "description": "Creation timestamp (Windows FILETIME)",
            "forensic_value": true
        },
        {
            "name": "data_size",
            "size": 4,
            "type": "uint",
            "description": "Size of the following data"
        },
        {
            "name": "data",
            "size": "$data_size",
            "type": "bytes",
            "description": "Variable-length data (size from data_size field)"
        },
        {
            "name": "file_type",
            "size": 1,
            "type": "uint",
            "description": "Type identifier",
            "expected_values": [0, 1, 2, 3],
            "value_map": {
                "0": "Unknown",
                "1": "Type A",
                "2": "Type B",
                "3": "Type C"
            }
        },
        {
            "name": "version_number",
            "size": 4,
            "type": "uint",
            "description": "Format version (must be 1-100)",
            "expected_values": {"min": 1, "max": 100}
        },
        {
            "name": "optional_field",
            "size": 16,
            "type": "bytes",
            "description": "Only present when flag 0 is set",
            "condition": "$flags & 0x01"
        },
        {
            "name": "record_count",
            "size": 4,
            "type": "uint",
            "description": "Number of records that follow"
        },
        {
            "_comment": "Repeat example: parse a struct N times based on a parsed field value",
            "name": "Records",
            "type": "struct",
            "description": "Repeated record structure",
            "repeat": "$record_count",
            "fields": [
                {
                    "name": "record_id",
                    "size": 4,
                    "type": "uint",
                    "description": "Record identifier"
                },
                {
                    "name": "record_data",
                    "size": 8,
                    "type": "bytes",
                    "description": "Record payload"
                }
            ]
        },
        {
            "_comment": "Repeat with fixed step: parse page-aligned blocks (use repeat_step for alignment)",
            "_comment2": "repeat can be a number, '$field_ref', an expression like '$field - 1', or 'eof'",
            "name": "Pages",
            "type": "struct",
            "description": "Fixed-size page structure (disabled example)",
            "enabled": false,
            "repeat": "eof",
            "repeat_step": 512,
            "fields": [
                {
                    "name": "page_header",
                    "size": 8,
                    "type": "bytes",
                    "description": "Page header"
                }
            ]
        },
        {
            "name": "remaining_data",
            "size": 0,
            "type": "remaining",
            "description": "All remaining bytes in the file"
        }
    ]
}
